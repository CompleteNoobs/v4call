 // Make voluntary 'call-end' (End Call button) consistent with 'disconnect':
 // remove the leaving user from room.members, emit user-left (so client UI updates),
 // check for empty room and delete it (ephemeral rooms), broadcastRooms().
 // Previously, 'call-end' only emitted peer-hung-up + processCallEnd but NEVER
 // removed the leaver from members list or cleaned empty room. This left stale
 // members and prevented proper last-user room deletion. Now fixed so rooms
 // behave correctly when users leave via UI (not just tab close).
 
 socket.on('call-end', async ({ callId }) => {
   const username = socket._username;
   const room     = socket._room;
   if (room && rooms[room]) {
+    // Remove leaver from members (was missing!)
+    rooms[room].members = rooms[room].members.filter(u => u.socketId !== socket.id);
+    socket.to(room).emit('user-left', socket.id);
+
     socket.to(room).emit('peer-hung-up', { by: username });
     const cid = rooms[room].callId || callId;
     if (cid) await processCallEnd(cid, room, io, lobbyUsers);
+
+    // Cleanup if now empty (consistent with disconnect handler)
+    if (rooms[room].members.length === 0) {
+      if (rooms[room]._capTimer)  clearTimeout(rooms[room]._capTimer);
+      if (rooms[room]._warnTimer) clearTimeout(rooms[room]._warnTimer);
+      delete rooms[room];
+      chatDeleteRoom(room);
+      console.log(`Room #${room} closed (last participant ended call)`);
+    }
+    broadcastRooms();
   }
   console.log(`@${username} ended call`);
 });
 
